extends "res://tests/test_strict0833.gd"
const Store=preload("res://war_engine/platform/save_store.gd")
func canonical(v):return JSON.parse_string(JSON.stringify(v))
func invalid_field(e,key,value):
 var bad=e.state.duplicate(true);bad.units[cav][key]=value
 check(not e.validate(bad),"reject "+key+"="+str(value))
func _initialize():
 var e=fresh();check(e.validate(e.state),"valid V35 state")
 var store=Store.new("user://v36_saves.json",JSON.stringify(e.pack).sha256_text())
 check(store.save_game(e),"write valid V36 state")
 var bytes=FileAccess.get_file_as_bytes(store.path);var copy=Rules.new(e.pack)
 check(store.load_game(copy) and canonical(copy.state)==canonical(e.state),"valid physical file roundtrip")
 for value in [-999,-1,"invalid",true,1.5,INF,NAN,null,19]:invalid_field(e,"isolation_turns",value)
 for value in [100,-1,"16",true,12.5,0,10]:invalid_field(e,"turn_ap_limit",value)
 for value in [-1,"invalid",true,16.5,17]:invalid_field(e,"ap",value)
 for value in ["invalid",true,1.5]:invalid_field(e,"cohesion",value)
 invalid_field(e,"morale","disorganized");invalid_field(e,"prisoners",-1);invalid_field(e,"reactions",2)
 e.state.units[cav].isolation_turns=-999
 check(not store.save_game(e) and FileAccess.get_file_as_bytes(store.path)==bytes,"invalid save cannot replace valid file")
 e=fresh()
 for u in e.state.units:u.erase("isolation_turns");u.erase("turn_ap_limit")
 check(e.validate(e.state) and store.save_game(e),"missing optional legacy fields accepted")
 copy=Rules.new(e.pack);check(store.load_game(copy) and copy.validate(copy.state),"legacy missing fields load safely")
 e=fresh();wall(e,19);e.end_side();e.end_side()
 store=Store.new("user://v36_isolated.json",JSON.stringify(e.pack).sha256_text());copy=Rules.new(e.pack)
 check(e.state.units[cav].isolation_turns==1 and e.state.units[cav].ap==8,"first isolation boundary")
 check(store.save_game(e) and store.load_game(copy) and copy.state.units[cav].isolation_turns==1 and copy.max_ap(cav)==8,"physical isolation roundtrip")
 e.state.units[cav].cell=[4,6];e.refresh_support()
 check(e.state.units[cav].isolation_turns==0,"reconnection resets isolation")
 check(store.save_game(e) and store.load_game(copy) and copy.state.units[cav].isolation_turns==0 and copy.state.units[cav].command_ok,"physical reconnected roundtrip")
 # Links can improve during a turn without granting additional AP.
 check(copy.max_ap(cav)==8,"stored reduced budget remains valid after reconnection")
 var valid=copy.state.duplicate(true);var save=Store.new("user://v36_fallback.json",JSON.stringify(copy.pack).sha256_text())
 check(save.save_game(copy) and save.save_game(copy),"prepare validated backup")
 var payload=JSON.stringify({"state":valid,"previous":{}});var f=FileAccess.open(save.path,FileAccess.WRITE)
 valid.units[cav].isolation_turns="invalid";payload=JSON.stringify({"state":valid,"previous":{}})
 f.store_string(JSON.stringify({"schema":1,"pack_hash":save.fingerprint,"payload":payload,"checksum":payload.sha256_text()}));f.close()
 check(save.load_game(copy) and save.recovered and copy.state.units[cav].isolation_turns==0,"semantically invalid checksummed primary recovers valid backup")
 var backup_bytes=FileAccess.get_file_as_bytes(save.path+".bak")
 check(save.save_game(copy),"recovered state autosaves safely")
 check(FileAccess.get_file_as_bytes(save.path+".bak")==backup_bytes,"invalid primary never replaces valid backup")
 var recovered_again=Rules.new(copy.pack)
 check(save.load_game(recovered_again) and recovered_again.validate(recovered_again.state) and not save.recovered,"new valid primary loads after recovery")
 print("V36 SAVES ",checks-failures,"/",checks);quit(1 if failures else 0)
