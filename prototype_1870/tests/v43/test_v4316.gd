extends "res://tests/test_ai_compat0833.gd"
const Prior=preload("res://tests/v43/reference_tactical_ai_v4315.gd")
func small(ids: Array,cells: Array):
 var p=data.duplicate(true);p.units=[];p.rules.fog.enabled=false;p.map.river_edges=[];p.map.tiles.fill("plain");p.map.elevations.fill(0)
 for id in ids:
  for u in data.units:
   if u.id==id:p.units.append(u.duplicate(true))
 for k in range(p.units.size()):p.units[k].arrival_turn=1;p.units[k].cell=cells[k]
 var e=Rules.new(p);e.new_game(1,"hard");e.state.turn=6;e.state.side=0;e.state.seed=18704316;e.state.ai_style=0
 for n in range(e.state.units.size()):
  e.state.units[n].formation="line" if not e.artillery(n) and not e.cavalry(n) else "none"
  if n>0:e.state.units[n].done=true
 e.refresh_support(false);e.refresh_intel();return e
func old_bot():
 var b=Prior.new();b.profiles=profiles;return b
func observed(e):
 var enemies=[]
 for n in range(e.state.units.size()):
  if int(e.state.units[n].side)!=0:enemies.append(n)
 return e.observation(0,enemies)
func _initialize():
 data=JSON.parse_string(FileAccess.get_file_as_string("res://packs/1870/regimental_trial_v43.json"));profiles=JSON.parse_string(FileAccess.get_file_as_string("res://packs/1870/ai_profiles.json"))
 var e=small(["fr_10","qg_fr_Pellé","pru_36","pru_37","pru_38"],[[18,6],[15,2],[18,8],[20,6],[17,4]])
 e.state.units[0].entrenched=true;e.pack.map.tiles[e.unit_cell(e.state.units[0])]="forest"
 e.pack.map.tiles[e.index(Vector2i(16,4))]="forest"
 e.pack.map.tiles[e.index(Vector2i(17,5))]="forest"
 e.pack.map.tiles[e.index(Vector2i(17,6))]="forest"
 var view=observed(e);var before=view.duplicate(true);var old=old_bot().choose(view);var ai=bot();var a=ai.choose(view)
 print("POCKET ",JSON.stringify(old)," -> ",JSON.stringify(a)," origin risk ",ai.defence.encirclement_risk(Rules.new(view.pack,view.state),0,e.unit_cell(e.state.units[0])))
 check(old.kind!="move","V43.15 holds the wooded objective under a visible pincer")
 check(a.kind=="move" and a.unit=="fr_10","threatened full-strength garrison disengages before encirclement")
 check(view==before,"pincer planning preserves sanitized input")
 if a.kind=="move":
  check(dispatch(e,a) and e.validate(e.state),"withdrawal uses legal production movement")
  check(e.state.units[0].command_ok and e.state.units[0].supply_ok,"withdrawal preserves both actual networks")
  check(e.state.units[0].cell!=[18,6],"unit leaves the threatened anchor instead of entrenching again")
  check(e.pack.map.tiles[e.unit_cell(e.state.units[0])]=="forest","retreat uses an available protected second-line position")
  var firing=false
  for j in range(e.state.units.size()):
   if e.fire_status(0,j)=="ok":firing=true
  check(int(e.state.units[0].ap)>=int(e.weapon(0).ap) and firing,"local covered withdrawal retains AP and a real shot against a visible attacker")
 # A frontal assault alone must not dislodge a protected, supplied garrison.
 e=small(["fr_10","qg_fr_Pellé","pru_36","pru_37"],[[18,6],[15,2],[18,8],[20,8]])
 e.state.units[0].entrenched=true;e.pack.map.tiles[e.unit_cell(e.state.units[0])]="forest"
 a=bot().choose(observed(e));print("FRONTAL ",JSON.stringify(a))
 check(a.kind=="fire" and dispatch(e,a),"protected supplied defender fires against a frontal attack")
 check(e.state.units[0].cell==[18,6] and e.state.units[0].entrenched,"frontally threatened strongpoint retained")
 # Do not abandon the three-point strongpoint while two exit directions remain.
 e=small(["fr_7","qg_fr_Pellé","pru_36","pru_37","pru_38"],[[11,5],[8,1],[11,7],[13,4],[13,2]])
 e.state.units[0].entrenched=true;e.pack.map.tiles[e.unit_cell(e.state.units[0])]="village"
 a=bot().choose(observed(e));check(a.kind=="fire" and dispatch(e,a),"valuable linked strongpoint keeps firing while the loose pincer remains containable")
 check(e.state.units[0].cell==[11,5],"three-point objective is not handed over for an unnecessary early retreat")
 # Regression snapshot generated by the synthetic scenario, not the user save.
 var checkpoint=JSON.parse_string(FileAccess.get_file_as_string("res://tests/fixtures/v4316_major_objective.json"));var pack=data.duplicate(true);pack.units=[]
 for u in checkpoint.units:
  for original in data.units:
   if original.id==u.id:pack.units.append(original.duplicate(true))
 e=Rules.new(pack,checkpoint);e.normalize();var defender=e.unit_index("fr_9")
 for n in range(e.state.units.size()):
  if int(e.state.units[n].side)==0 and n!=defender:e.state.units[n].done=true
 check(e.validate(e.state) and e.state.units[defender].supply_ok and e.state.units[defender].command_ok,"synthetic regression snapshot still has a linked major-objective garrison")
 a=bot().choose(e.observation(0));check(a.kind=="fire" and a.unit=="fr_9" and dispatch(e,a),"major garrison fires instead of repeating the rejected premature evacuation")
 check(e.state.units[defender].cell==[11,5] and e.state.units[defender].entrenched,"critical objective and entrenchment retained in the regression snapshot")
 # Small mounted raiders do not make a supported infantry strongpoint panic.
 e=small(["fr_10","fr_14","qg_fr_Pellé","pru_54","pru_55","pru_56"],[[18,6],[17,5],[15,2],[18,8],[20,5],[20,3]])
 e.state.units[0].entrenched=true;e.pack.map.tiles[e.unit_cell(e.state.units[0])]="forest"
 a=bot().choose(observed(e));check(a.kind=="fire" and dispatch(e,a),"strong supported infantry fires on small visible cavalry raiders")
 check(e.state.units[0].cell==[18,6],"numerically superior screen retains its strongpoint instead of fleeing a weak pincer")
 # Native terrain/entrenchment power matters, not just raw troop totals.
 e=small(["fr_10","fr_14","fr_15","qg_fr_Pellé","pru_36","pru_37","pru_38"],[[18,6],[17,5],[18,5],[15,2],[18,8],[20,5],[20,3]])
 for n in range(3):e.state.units[n].entrenched=true;e.pack.map.tiles[e.unit_cell(e.state.units[n])]="forest"
 a=bot().choose(observed(e));check(a.kind=="fire" and dispatch(e,a),"supported entrenched woodland line uses its real holding power against the visible pincer")
 check(e.state.units[0].cell==[18,6],"terrain-supported objective is not evacuated on raw-headcount estimates alone")
 # Uninterrupted open LOS is not a reason to leave a gun under a rear pincer.
 e=small(["art_fr_Pellé0","qg_fr_Pellé","pru_36","pru_37","pru_38"],[[18,6],[15,2],[18,8],[20,6],[17,4]])
 e.state.units[0].deployed=true;e.state.units[0].ap=16
 old=old_bot().choose(observed(e));a=bot().choose(observed(e));print("GUN ",JSON.stringify(old)," -> ",JSON.stringify(a))
 check(a.kind=="limber" and a.has("path") and dispatch(e,a),"battery can limber for a legal retreat despite an existing firing lane")
 if a.kind=="limber":
  a=bot().choose(observed(e))
  check(a.kind=="move" and dispatch(e,a) and e.validate(e.state),"limbered battery actually reaches a legal fallback cell")
 # Headquarters are not left behind the front under the same visible pincer.
 e=small(["qg_fr_Pellé","fr_10","pru_36","pru_37","pru_38"],[[18,6],[18,8],[18,9],[20,5],[20,3]])
 a=bot().choose(observed(e));print("HQ ",JSON.stringify(a))
 check(a.kind=="move" and a.unit=="qg_fr_Pellé" and dispatch(e,a),"HQ withdraws instead of waiting under a visible envelopment")
 check(e.enemy_distance(0,e.unit_cell(e.state.units[0]))>=3,"HQ fallback creates real separation from the attackers")
 # A fresh reserve responds to a visible incursion at the supply entry/HQ.
 e=small(["fr_8","fr_7","fr_9","fr_10","qg_fr_Pellé","pru_36"],[[12,5],[11,5],[13,10],[18,6],[11,3],[11,1]])
 e.pack.map.tiles[e.index(Vector2i(12,3))]="village"
 var origin=e.unit_cell(e.state.units[0]);var source=e.index(Vector2i(11,1));ai=bot();a=ai.choose(observed(e));print("REAR GUARD ",JSON.stringify(a))
 check(a.kind=="move" and dispatch(e,a) and e.validate(e.state),"available reserve makes a legal response to the rear incursion")
 check(e.distance(e.unit_cell(e.state.units[0]),source)<e.distance(origin,source),"reserve closes on the threatened supply entry instead of staying by the objective")
 # A supplied unit knows its own cut even if the cutting enemy is not observed.
 e=small(["fr_10","qg_fr_Pellé"],[[18,6],[15,2]])
 view=observed(e);view.state.units[0].command_ok=false;view.state.units[0].supply_ok=false;view.state.units[0].isolation_turns=2;view.state.units[0].ap=8;view.state.units[0].turn_ap_limit=8;view.state.units[0].ammo_level=2
 before=view.duplicate(true);a=bot().choose(view)
 check(a.kind=="move" and view==before,"own known double cut triggers a legal attempt to leave without locating a hidden enemy")
 e=small(["fr_7","qg_fr_Pellé"],[[11,5],[8,1]]);e.state.units[0].entrenched=true
 view=observed(e);view.state.units[0].command_ok=false;view.state.units[0].supply_ok=false;view.state.units[0].isolation_turns=1;view.state.units[0].ap=8;view.state.units[0].turn_ap_limit=8
 a=bot().choose(view);check(a.kind!="move","major strongpoint with no observed enclosure is not emptied at the first unconfirmed cut")
 view.state.units[0].isolation_turns=2;a=bot().choose(view)
 check(a.kind=="move","second isolation count releases the garrison before the unchanged third-count consequences")
 # An already closed ring cannot be escaped by inventing a path or a bonus.
 e=small(["fr_10","qg_fr_Pellé","pru_36","pru_37","pru_38","pru_39","pru_40","pru_41"],[[18,6],[15,2],[1,1],[2,1],[3,1],[4,1],[5,1],[6,1]])
 var ring=e.neighbours(e.unit_cell(e.state.units[0]))
 for n in range(6):e.state.units[n+2].cell=[e.cell(ring[n]).x,e.cell(ring[n]).y]
 e.refresh_support(false);var force=e.state.units[0].strength;var ap=e.state.units[0].ap
 a=bot().choose(observed(e));check(a.kind!="move" and dispatch(e,a) and e.validate(e.state),"fully closed ring yields a legal remaining action without teleporting")
 check(e.state.units[0].strength<=force and e.state.units[0].ap<=ap,"encircled unit receives no strength or AP bonus")
 # Moving an unobserved enemy in the real world leaves identical decisions.
 var world=Rules.new(data);world.new_game(1,"hard");world.state.ai_style=0;world.state.seed=18704316
 var twin=Rules.new(data);twin.state=world.state.duplicate(true);var hidden=world.unit_index("pru_55")
 twin.state.units[hidden].cell=[29,19];twin.refresh_intel();world.refresh_intel()
 check(not world.visible_to(0,hidden) and not twin.visible_to(0,hidden),"hidden-world fixture really keeps the opponent unseen")
 check(world.observation(0)==twin.observation(0) and bot().choose(world.observation(0))==bot().choose(twin.observation(0)),"anti-encirclement policy cannot locate an unseen flanking unit")
 # All other policies keep exactly the same orders and relocation state.
 for side in [0,1]:
  for mode in ["medium","hard"]:
   if side==0 and mode=="hard":continue
   world=Rules.new(data);world.new_game(1,mode);world.state.side=side;world.state.seed=18704316;world.state.ai_style=0;world.refresh_intel()
   var current=bot();var prior=old_bot();view=world.observation(side)
   if side==0 and mode=="medium":prior=load("res://war_engine/ai/v4316_ai.gd").new();prior.profiles=profiles
   for step in range(4):
    var reference_view=view.duplicate(true)
    if side==0 and mode=="medium":reference_view.state.ai_difficulty="hard"
    var x=current.choose(view);var y=prior.choose(reference_view)
