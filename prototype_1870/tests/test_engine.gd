extends SceneTree
const Rules=preload("res://war_engine/core/engine.gd")
const Store=preload("res://war_engine/platform/save_store.gd")
var checks=0
var failures=0
func check(ok: bool,name: String):
	checks+=1
	if not ok:failures+=1;printerr("FAIL: "+name)
func _initialize():
	var pack=JSON.parse_string(FileAccess.get_file_as_string("res://tests/fixtures/prototype08.json"))
	var e=Rules.new(pack)
	check(e.validate(e.state),"initial state valid")
	check(e.width*e.height==600,"600 cells")
	check(e.state.units.size()==10,"ten units")
	check(e.neighbours(e.index(Vector2i(10,10))).size()==6,"six neighbours")
	var symmetry=true
	for i in range(600):
		for n in e.neighbours(i):
			if not e.neighbours(n).has(i):symmetry=false
	check(symmetry,"symmetric adjacency")
	var start=e.state.duplicate(true)
	check(e.move(0,[e.unit_cell(e.state.units[0]),599])=="invalid","teleport rejected")
	check(e.state==start,"invalid move unchanged")
	check(e.path_to(0,e.index(Vector2i(14,7))).is_empty(),"river blocked")
	check(e.path_to(0,e.unit_cell(e.state.units[1])).is_empty(),"stacking blocked")
	check(e.path_to(4,e.index(Vector2i(17,8))).is_empty(),"enemy not activated")
	var path=e.path_to(0,e.index(Vector2i(14,8)))
	check(not path.is_empty(),"bridge reachable")
	var cost=e.path_cost(path)
	check(e.move(0,path)=="moved","move applied")
	check(e.state.units[0].ap==16-cost,"AP paid")
	check(e.undo(),"undo allowed")
	check(e.state==start,"undo exact")
	check(not e.undo(),"single undo")
	check(e.move(0,e.path_to(0,e.index(Vector2i(11,8))))=="moved","first activation")
	check(e.move(1,e.path_to(1,e.index(Vector2i(11,10))))=="moved","second activation")
	check(not e.state.units[0].done,"previous unit stays available")
	check(e.can_act(0),"free return to previous unit")
	check(e.undo() and not e.state.units[0].done,"undo restores activation")
	e.end_side()
	check(e.state.side==1 and e.state.turn==1,"second camp same round")
	check(e.previous.is_empty(),"turn clears undo")
	e.end_side()
	check(e.state.side==0 and e.state.turn==2,"next round")
	check(e.state.units[0].ap==16 and not e.state.units[0].done,"AP refreshed")
	e.new_game();e.state.units[0].cell=[15,8]
	check(e.move(0,e.path_to(0,e.objective()))=="capture","objective captured")
	check(e.state.owner==0,"owner changed")
	check(not e.undo(),"capture irreversible")
	e.end_side()
	check(e.state.scores==[0,0],"score waits full round")
	e.end_side()
	check(e.state.scores==[1,0],"garrison scores")
	for k in range(10):e.end_side()
	check(e.state.finished and e.state.turn==6,"game ends round six")
	check(e.state.scores==[6,0],"six scoring rounds")
	e.end_side()
	check(e.state.scores==[6,0],"no postgame scoring")
	e.new_game();e.state.owner=0;e.end_side();e.end_side()
	check(e.state.scores==[1,0],"empty controlled objective keeps scoring")
	var store=Store.new("user://test_save.json","test-pack")
	check(store.save_game(e),"save write")
	var f=Rules.new(pack)
	check(store.load_game(f) and f.state==e.state,"save roundtrip")
	e.end_side();check(store.save_game(e),"save backup rotation")
	var corrupt=FileAccess.open("user://test_save.json",FileAccess.WRITE);corrupt.store_string("broken");corrupt.close()
	check(store.load_game(f) and store.recovered and f.state.side==0,"corrupt current recovers backup")
	check(not Store.new("user://test_save.json","different-pack").load_game(f),"wrong pack rejected")
	var invalid=e.state.duplicate(true);invalid.units[1].cell=invalid.units[0].cell.duplicate()
	check(not e.validate(invalid),"overlap rejected")
	print("ENGINE CHECKS: %d passed / %d total"%[checks-failures,checks])
	for suffix in ["",".bak",".tmp"]:DirAccess.remove_absolute("user://test_save.json"+suffix)
	quit(1 if failures>0 else 0)
