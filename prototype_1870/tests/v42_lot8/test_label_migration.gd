extends "res://tests/test_ai_compat0833.gd"
func _initialize():
	var args=OS.get_cmdline_user_args()
	var old_raw=FileAccess.get_file_as_string(args[0])
	var new_raw=FileAccess.get_file_as_string("res://packs/1870/regimental_trial_v42_lot8.json")
	var old_pack=JSON.parse_string(old_raw);var new_pack=JSON.parse_string(new_raw)
	var old_copy=old_pack.duplicate(true);var new_copy=new_pack.duplicate(true)
	for key in ["scenario_status","save_migrations"]:old_copy.erase(key);new_copy.erase(key)
	check(old_copy==new_copy,"label fix preserves every gameplay field")
	check(str(new_pack.scenario_status).begins_with("V42 LOT 8"),"lot 8 metadata label corrected")
	check(new_pack.save_migrations.size()==1 and new_pack.save_migrations.has(old_raw.sha256_text()),"only the identical test pack is accepted for migration")
	var baseline_raw=FileAccess.get_file_as_string("res://packs/1870/regimental_trial_v42_experimental.json")
	check(not new_pack.save_migrations.has(baseline_raw.sha256_text()),"original different strengths cannot migrate into lot 8")
	var live=Rules.new(old_pack);live.new_game(0,"medium")
	var restored_live=Rules.new(new_pack)
	check(Store.new("user://test_apk_save.json",old_raw.sha256_text()).save_game(live),"unfinished test APK game saves")
	check(Store.new("user://test_apk_save.json",new_raw.sha256_text(),new_pack.save_migrations).load_game(restored_live) and restored_live.validate(restored_live.state),"unfinished test APK save migrates")
	check(JSON.parse_string(JSON.stringify(live.state))==JSON.parse_string(JSON.stringify(restored_live.state)),"unfinished game remains identical")
	for path in args.slice(1):
		var a=Rules.new(old_pack);var b=Rules.new(new_pack)
		var old_store=Store.new(path,old_raw.sha256_text())
		var new_store=Store.new(path,new_raw.sha256_text(),new_pack.save_migrations)
		check(old_store.load_game(a),"tested old-pack checkpoint loads")
		check(new_store.load_game(b) and b.validate(b.state),"final pack accepts and validates test APK checkpoint")
		var restored=b.state.duplicate(true);restored.erase("completed_turn_limit")
		check(JSON.parse_string(JSON.stringify(a.state))==JSON.parse_string(JSON.stringify(restored)),"migration preserves all game state and history")
		check(a.result_for(1)==b.result_for(1),"migration preserves final score")
	var f=FileAccess.open("user://label_migration.json",FileAccess.WRITE)
	f.store_string(JSON.stringify({"checks":checks,"failures":failures},"\t"));f.close()
	print("LOT8 LABEL MIGRATION ",checks-failures,"/",checks);quit(1 if failures else 0)
